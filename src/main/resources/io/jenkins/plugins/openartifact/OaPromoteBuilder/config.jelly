<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Server}" field="server">
    <f:select/>
  </f:entry>
  <f:entry title="${%Bundle}" field="bundle">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Version}" field="version">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Stage}" field="stage">
    <f:textbox/>
  </f:entry>
  <f:advanced>
    <f:entry title="${%Installation}" field="installation">
      <f:select/>
    </f:entry>
    <f:entry title="${%TargetRepo}" field="targetRepo">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%Notes}" field="notes">
      <f:textarea/>
    </f:entry>
  </f:advanced>
</j:jelly>
