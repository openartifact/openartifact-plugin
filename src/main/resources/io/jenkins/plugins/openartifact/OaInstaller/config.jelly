<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Version}" field="version">
    <f:textbox default="latest"/>
  </f:entry>
  <f:advanced>
    <f:entry title="${%Download URL}" field="downloadUrl">
      <f:textbox/>
    </f:entry>
  </f:advanced>
</j:jelly>
