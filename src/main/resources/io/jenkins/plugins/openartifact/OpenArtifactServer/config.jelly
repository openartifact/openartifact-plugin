<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Server ID}" field="id">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%URL}" field="url">
    <f:textbox placeholder="https://artifacts.example.com"/>
  </f:entry>
  <f:entry title="${%Credentials}" field="credentialsId">
    <c:select/>
  </f:entry>
  <f:validateButton title="${%Test connection}" progress="${%Testing...}" method="testConnection" with="url"/>
  <f:entry>
    <div align="right"><f:repeatableDeleteButton/></div>
  </f:entry>
</j:jelly>
